model TechnicianApplication {
  id String @id @default(uuid())

  name    String
  email   String  @unique
  phone   String?
  address String?

  qualifications  String
  experienceYears Int
  bio             String?

  resume              String?
  resumePublicId      String?
  additionalDocuments Json?

  status         TechnicianApplicationStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?

  technicianId String?     @unique
  technician   Technician? @relation(fields: [technicianId], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email], name: "idx_technician_application_email")
  @@index([status], name: "idx_technician_application_status")
  @@map("technician_applications")
}