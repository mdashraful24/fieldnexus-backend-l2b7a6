model WorkAssignment {
  id String @id @default(uuid())

  status AssignmentStatus @default(PENDING)

  rejectionReason String?

  assignedAt  DateTime  @default(now())
  acceptedAt  DateTime?
  cancelledAt DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  @@index([workOrderId], name: "idx_work_assignment_workOrderId")
  @@index([vendorId], name: "idx_work_assignment_vendorId")
  @@index([technicianId], name: "idx_work_assignment_technicianId")
  @@index([status], name: "idx_work_assignment_status")
  @@map("work_assignments")
}
