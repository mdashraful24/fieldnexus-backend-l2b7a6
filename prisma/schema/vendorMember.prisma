model VendorMember {
  id String @id @default(uuid())

  vendorId     String
  technicianId String

  joinedAt DateTime @default(now())
  isActive Boolean  @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())

  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([vendorId, technicianId])
  @@index([vendorId], name: "idx_vendor_member_vendorId")
  @@index([technicianId], name: "idx_vendor_member_technicianId")
  @@map("vendor_members")
}
